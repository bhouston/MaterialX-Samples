#usda 1.0
(
    defaultPrim = "materialx_shaderball"
    upAxis = "Z"
)

over "materialx_shaderball" (
    variants = {
        string suite = "showcase"
    }
    prepend variantSets = "suite"
)
{
    variantSet "suite" = {
        "library" {
            def Xform "library" (
                kind = "component"
                variants = {
                    string material = "open_pbr_surface__brushed_metal_anisotropy"
                }
                prepend variantSets = "material"
            )
            {
                def Xform "shader_ball" (
                    prepend references = @../ShaderBall.usdc@</root>
                )
                {
                }

                variantSet "material" = {
                    "open_pbr_surface__brushed_metal_anisotropy" {
                        def Scope "Materials" (
                            prepend references = @../materials/library/open_pbr_surface/brushed_metal_anisotropy/brushed_metal_anisotropy.mtlx@</MaterialX/Materials>
                        )
                        {
                        }

                        over "shader_ball"
                        {
                            over "Preview_Mesh"
                            {
                                over "Preview_Mesh" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    rel material:binding = </materialx_shaderball/library/Materials/Aluminum_Brushed>
                                }
                            }
                            over "Calibration_Mesh"
                            {
                                over "Calibration_Mesh" (
                                    prepend apiSchemas = ["MaterialBindingAPI"]
                                )
                                {
                                    rel material:binding = </materialx_shaderball/library/Materials/Aluminum_Brushed>
                                }
                            }
                        }
                    }

