    variantSet "material" = {
        "openpbr_carpaint" {
            def Scope "Materials" (
                prepend references = @../materials/openpbr/openpbr_carpaint/carpaint.mtlx@</MaterialX/Materials>
            )
            {
            }

            over "shader_ball"
            {
                over "Preview_Mesh"
                {
                    over "Preview_Mesh" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </materialx_shaderball_showcase/Materials/Car_Paint>
                    }
                }
                over "Calibration_Mesh"
                {
                    over "Calibration_Mesh" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </materialx_shaderball_showcase/Materials/Car_Paint>
                    }
                }
            }
        }

