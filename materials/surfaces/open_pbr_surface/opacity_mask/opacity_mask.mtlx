<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_opacity_mask">
    <position name="obj_pos" type="vector3" />
    <dotproduct name="wave_driver" type="float">
      <input name="in1" type="vector3" nodename="obj_pos" />
      <input name="in2" type="vector3" value="1.0, 0.0, 1.0" />
    </dotproduct>
    <multiply name="wave_scale" type="float">
      <input name="in1" type="float" nodename="wave_driver" />
      <input name="in2" type="float" value="7.0" />
    </multiply>
    <sin name="wave" type="float">
      <input name="in" type="float" nodename="wave_scale" />
    </sin>
    <multiply name="wave_to_zero_one_scale" type="float">
      <input name="in1" type="float" nodename="wave" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="wave_to_zero_one" type="float">
      <input name="in1" type="float" nodename="wave_to_zero_one_scale" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <ifgreater name="opacity_mask" type="float">
      <input name="value1" type="float" nodename="wave_to_zero_one" />
      <input name="value2" type="float" value="0.5" />
      <input name="in1" type="float" value="1.0" />
      <input name="in2" type="float" value="0.0" />
    </ifgreater>
    <output name="out_alpha_mask" type="float" nodename="opacity_mask" />
  </nodegraph>
  <surfacematerial name="opacity_mask" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="open_pbr_surface_surfaceshader" />
  </surfacematerial>
  <open_pbr_surface name="open_pbr_surface_surfaceshader" type="surfaceshader">
    <input name="base_color" type="color3" value="0.0518895, 0.29606, 0.425324" />
    <input name="geometry_opacity" type="float" nodegraph="NG_opacity_mask" output="out_alpha_mask" />
  </open_pbr_surface>
</materialx>
