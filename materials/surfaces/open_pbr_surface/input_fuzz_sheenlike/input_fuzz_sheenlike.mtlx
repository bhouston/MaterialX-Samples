<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <surfacematerial name="input_fuzz_sheenlike" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="open_pbr_surface_sheen" />
