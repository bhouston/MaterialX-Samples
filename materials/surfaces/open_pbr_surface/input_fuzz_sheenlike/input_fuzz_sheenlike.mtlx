    <input name="base_metalness" type="float" value="0.0" />
    <input name="specular_weight" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.8" />
    <input name="fuzz_weight" type="float" value="0.8" />
    <input name="fuzz_color" type="color3" value="1.0, 0.9, 0.7" />
    <input name="fuzz_roughness" type="float" value="0.3" />
    <input name="geometry_opacity" type="float" value="1.0" />
  </open_pbr_surface>
</materialx>