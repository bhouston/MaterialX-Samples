<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_coat_color_variation" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular_roughness" type="float" value="0.25" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1, 1, 1" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="1.0" />
    <input name="coat_color" type="color3" value="0.85, 0.2, 0.25" />
    <input name="coat_roughness" type="float" value="0.05" />
    <input name="transmission" type="float" value="0" />
    <input name="opacity" type="color3" value="1, 1, 1" />
  </standard_surface>
  <surfacematerial name="CoatColorVariation" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_coat_color_variation" />
  </surfacematerial>
</materialx>
