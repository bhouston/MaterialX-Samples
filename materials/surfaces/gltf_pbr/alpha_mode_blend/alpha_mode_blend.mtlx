<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <gltf_pbr name="SR_gltf_alpha_mode_blend" type="surfaceshader">
    <input name="base_color" type="color3" value="0.2, 0.2, 0.9" />
    <input name="metallic" type="float" value="0.0" />
    <input name="roughness" type="float" value="0.5" />
    <input name="alpha" type="float" value="0.35" />
    <input name="alpha_mode" type="integer" value="2" />
    <input name="alpha_cutoff" type="float" value="0.5" />
  </gltf_pbr>
  <surfacematerial name="M_gltf_alpha_mode_blend" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_gltf_alpha_mode_blend" />
  </surfacematerial>
</materialx>
