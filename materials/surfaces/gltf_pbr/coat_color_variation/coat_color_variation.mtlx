<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <gltf_pbr name="SR_coat_color_variation" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0.8, 0.8" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.25" />
    <input name="occlusion" type="float" value="1" />
    <input name="transmission" type="float" value="0" />
    <input name="specular" type="float" value="1" />
    <input name="specular_color" type="color3" value="0.2, 0.35, 0.9" />
    <input name="ior" type="float" value="1.5" />
    <input name="alpha" type="float" value="1" />
    <input name="alpha_mode" type="integer" value="0" />
    <input name="alpha_cutoff" type="float" value="0.5" />
    <input name="clearcoat" type="float" value="1.0" />
    <input name="clearcoat_roughness" type="float" value="0.05" />
  </gltf_pbr>
  <surfacematerial name="CoatColorVariation" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_coat_color_variation" />
  </surfacematerial>
</materialx>
