<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_gltf_iridescence_thickness">
    <texcoord name="uv0" type="vector2" />
    <position name="pos0" type="vector3" />
    <separate2 name="uv_split" type="multioutput"><input name="in" type="vector2" nodename="uv0" /></separate2>
    <add name="uv_sum" type="float"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /></add>
    <multiply name="uv_mul" type="float"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /></multiply>
    <fract name="uv_mix" type="float"><input name="in" type="float" nodename="uv_sum" /></fract>
    <multiply name="uv_times4" type="float"><input name="in1" type="float" nodename="uv_mix" /><input name="in2" type="float" value="4.0" /></multiply>
    <floor name="uv_i_float" type="float"><input name="in" type="float" nodename="uv_times4" /></floor>
    <constant name="uv_i" type="integer"><input name="value" type="integer" value="0" /></constant>
    <ifgreater name="uv_bool" type="boolean"><input name="value1" type="float" nodename="uv_mix" /><input name="value2" type="float" value="0.5" /></ifgreater>
    <combine2 name="uv_scale" type="vector2"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="uv_mix" /></combine2>
    <combine2 name="uv_offset" type="vector2"><input name="in1" type="float" nodename="uv_mul" /><input name="in2" type="float" nodename="uv_mix" /></combine2>
    <combine3 name="uv_vec3" type="vector3"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /></combine3>
    <normalize name="uv_normal" type="vector3"><input name="in" type="vector3" nodename="uv_vec3" /></normalize>
    <combine4 name="uv_vec4" type="vector4"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /><input name="in4" type="float" value="1.0" /></combine4>
    <combine4 name="uv_color4" type="color4"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /><input name="in4" type="float" value="1.0" /></combine4>
    <combine3 name="uv_color" type="color3"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /></combine3>
    <combine3 name="uv_color_hot" type="color3"><input name="in1" type="float" value="0.95" /><input name="in2" type="float" nodename="uv_split" output="outx" /><input name="in3" type="float" value="0.2" /></combine3>
    <combine3 name="uv_color_cool" type="color3"><input name="in1" type="float" value="0.1" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" value="0.8" /></combine3>
    <add name="temp_driver" type="float"><input name="in1" type="float" value="2500" /><input name="in2" type="float" value="4000" /></add>
    <add name="ior_driver" type="float"><input name="in1" type="float" value="1.1" /><input name="in2" type="float" nodename="uv_mul" /></add>
    <multiply name="uv_rotate" type="float"><input name="in1" type="float" nodename="uv_mix" /><input name="in2" type="float" value="0.785398" /></multiply>
    <gltf_iridescence_thickness name="node_under_test" type="float" nodedef="ND_gltf_iridescence_thickness_float_1_0">
      <input name="file" type="filename" value="textures/grid.png" />
      <input name="default" type="vector3" nodename="uv_vec3" />
      <input name="texcoord" type="vector2" nodename="uv0" />
      <input name="pivot" type="vector2" value="0.5, 0.5" />
      <input name="scale" type="vector2" nodename="uv_scale" />
      <input name="rotate" type="float" nodename="uv_rotate" />
      <input name="offset" type="vector2" nodename="uv_offset" />
      <input name="uaddressmode" type="string" value="periodic" />
      <input name="vaddressmode" type="string" value="periodic" />
      <input name="filtertype" type="string" value="linear" />
      <input name="thicknessMin" type="float" value="120.0" />
      <input name="thicknessMax" type="float" value="900.0" />
    </gltf_iridescence_thickness>
    <output name="out_iridescence_thickness" type="float" nodename="node_under_test" />
  </nodegraph>
  <gltf_pbr name="SR_gltf_iridescence_thickness" type="surfaceshader">
    <input name="base_color" type="color3" value="0.14, 0.16, 0.18" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.08" />
    <input name="specular" type="float" value="1.0" />
    <input name="ior" type="float" value="1.5" />
    <input name="iridescence" type="float" value="1.0" />
    <input name="iridescence_ior" type="float" value="1.33" />
    <input name="iridescence_thickness" type="float" nodegraph="NG_gltf_iridescence_thickness" output="out_iridescence_thickness" />
  </gltf_pbr>
  <surfacematerial name="M_gltf_iridescence_thickness" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_gltf_iridescence_thickness" />
  </surfacematerial>
</materialx>