<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_remap_degenerate">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <subtract name="centered_u" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <remap name="remap_forward" type="float" nodedef="ND_remap_float">
      <input name="in" type="float" nodename="centered_u" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="0.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="1.0" />
    </remap>
    <remap name="remap_reverse" type="float" nodedef="ND_remap_float">
      <input name="in" type="float" nodename="centered_u" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="0.0" />
      <input name="outlow" type="float" value="1.0" />
      <input name="outhigh" type="float" value="0.0" />
    </remap>
    <combine3 name="debug_color" type="color3">
      <input name="in1" type="float" nodename="remap_forward" />
      <input name="in2" type="float" nodename="remap_reverse" />
      <input name="in3" type="float" value="0.5" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="debug_color" />
  </nodegraph>
  <standard_surface name="SR_remap_degenerate" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_remap_degenerate" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_remap_degenerate" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_remap_degenerate" />
  </surfacematerial>
</materialx>
