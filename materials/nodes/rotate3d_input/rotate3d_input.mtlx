<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_rotate3d_input">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="separate_texcoord" type="multioutput">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <combine3 name="texcoord_3d" type="vector3">
      <input name="in1" type="float" nodename="separate_texcoord" output="outx" />
      <input name="in2" type="float" nodename="separate_texcoord" output="outy" />
      <input name="in3" type="float" value="0.0" />
    </combine3>
    <convert name="input_color" type="color3" nodedef="ND_convert_vector3_color3">
      <input name="in" type="vector3" nodename="texcoord_3d" />
    </convert>
    <output name="out_base_color" type="color3" nodename="input_color" />
  </nodegraph>
  <standard_surface name="SR_rotate3d_input" type="surfaceshader">
    <input name="base_color" type="color3" value="0.0, 0.0, 0.0" />
    <input name="emission_color" type="color3" nodegraph="NG_rotate3d_input" output="out_base_color" />
    <input name="emission" type="float" value="1.0" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.0" />
  </standard_surface>
  <surfacematerial name="M_rotate3d_input" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_rotate3d_input" />
  </surfacematerial>
</materialx>
