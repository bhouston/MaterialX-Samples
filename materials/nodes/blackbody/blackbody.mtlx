<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_blackbody">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <ifgreatereq name="temperature_low_or_mid" type="float">
      <input name="value1" type="float" nodename="uv_split" output="outx" />
      <input name="value2" type="float" value="0.333" />
      <input name="in1" type="float" value="4500" />
      <input name="in2" type="float" value="1900" />
    </ifgreatereq>
    <ifgreatereq name="temperature_selection" type="float">
      <input name="value1" type="float" nodename="uv_split" output="outx" />
      <input name="value2" type="float" value="0.666" />
      <input name="in1" type="float" value="9000" />
      <input name="in2" type="float" nodename="temperature_low_or_mid" />
    </ifgreatereq>
    <blackbody name="node_under_test" type="color3" nodedef="ND_blackbody">
      <input name="temperature" type="float" nodename="temperature_selection" />
    </blackbody>
    <output name="out_emission_color" type="color3" nodename="node_under_test" />
  </nodegraph>
  <standard_surface name="SR_blackbody" type="surfaceshader">
    <input name="base_color" type="color3" value="0.03, 0.03, 0.03" />
    <input name="specular_roughness" type="float" value="0.6" />
    <input name="specular" type="float" value="0.1" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" nodegraph="NG_blackbody" output="out_emission_color" />
  </standard_surface>
  <surfacematerial name="M_blackbody" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_blackbody" />
  </surfacematerial>
</materialx>
