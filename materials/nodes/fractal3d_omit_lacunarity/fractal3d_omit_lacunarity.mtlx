      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="1.0" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_r" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="1.00" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_g" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="0.00" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_b" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="0.62" />
