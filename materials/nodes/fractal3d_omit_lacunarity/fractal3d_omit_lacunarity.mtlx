<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_fractal3d_omit_lacunarity">
    <position name="pos0" type="vector3" />
    <combine3 name="pos_scale" type="vector3"><input name="in1" type="float" value="5.5" /><input name="in2" type="float" value="5.5" /><input name="in3" type="float" value="5.5" /></combine3>
