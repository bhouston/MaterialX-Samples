      <input name="in2" type="float" nodename="tint_g" />
      <input name="in3" type="float" nodename="tint_b" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="base_color" />
  </nodegraph>
  <standard_surface name="SR_fractal3d_omit_lacunarity" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_fractal3d_omit_lacunarity" output="out_base_color" />
