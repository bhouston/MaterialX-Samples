<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="M_place2d_rotate_pivot" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_place2d_rotate_pivot" />
  </surfacematerial>
  <standard_surface name="SR_place2d_rotate_pivot" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_place2d_rotate_pivot" output="out" />
    <input name="specular_roughness" type="float" value="0.4" />
  </standard_surface>
  <nodegraph name="NG_place2d_rotate_pivot">
    <texcoord name="uv0" type="vector2" />
    <place2d name="uv_transform" type="vector2">
      <input name="texcoord" type="vector2" nodename="uv0" />
      <input name="pivot" type="vector2" value="0.5, 0.5" />
      <input name="rotate" type="float" value="30.0" />
    </place2d>
    <image name="base_image" type="color3">
      <input name="file" type="filename" value="../image_format_png/textures/texture.png" colorspace="srgb_texture" />
      <input name="default" type="color3" value="1.0, 0.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="uv_transform" />
    </image>
    <output name="out" type="color3" nodename="base_image" />
  </nodegraph>
</materialx>
