<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_remap">
    <position name="pos0" type="vector3" />
    <dotproduct name="pos_x" type="float">
      <input name="in1" type="vector3" nodename="pos0" />
      <input name="in2" type="vector3" value="1, 0, 0" />
    </dotproduct>
    <dotproduct name="pos_y" type="float">
      <input name="in1" type="vector3" nodename="pos0" />
      <input name="in2" type="vector3" value="0, 1, 0" />
    </dotproduct>
    <dotproduct name="pos_z" type="float">
      <input name="in1" type="vector3" nodename="pos0" />
      <input name="in2" type="vector3" value="0, 0, 1" />
    </dotproduct>
    <combine3 name="pos_color" type="color3">
      <input name="in1" type="float" nodename="pos_x" />
      <input name="in2" type="float" nodename="pos_y" />
      <input name="in3" type="float" nodename="pos_z" />
    </combine3>
    <remap name="node_under_test" type="color3" nodedef="ND_remap_color3">
      <input name="in" type="color3" nodename="pos_color" />
      <input name="inlow" type="color3" value="-2, -2, -2" />
      <input name="inhigh" type="color3" value="2, 2, 2" />
      <input name="outlow" type="color3" value="0.08, 0.12, 0.55" />
      <input name="outhigh" type="color3" value="0.98, 0.86, 0.15" />
    </remap>
    <output name="out_base_color" type="color3" nodename="node_under_test" />
  </nodegraph>
  <standard_surface name="SR_remap" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_remap" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.35" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_remap" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_remap" />
  </surfacematerial>
</materialx>
