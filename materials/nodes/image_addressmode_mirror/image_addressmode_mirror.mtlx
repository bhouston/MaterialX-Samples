<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_image_addressmode_mirror">
    <texcoord name="uv0" type="vector2" />
    <multiply name="uv_scaled" type="vector2">
      <input name="in1" type="vector2" nodename="uv0" />
      <input name="in2" type="vector2" value="3.0, 3.0" />
    </multiply>
    <add name="uv_expanded" type="vector2">
      <input name="in1" type="vector2" nodename="uv_scaled" />
      <input name="in2" type="vector2" value="-1.0, -1.0" />
    </add>
    <image name="node_under_test" type="color3" nodedef="ND_image_color3">
      <input name="file" type="filename" value="../image_addressmode_constant/textures/address_modes.png" colorspace="srgb_texture" />
      <input name="default" type="color3" value="1.0, 0.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="uv_expanded" />
      <input name="uaddressmode" type="string" value="mirror" />
      <input name="vaddressmode" type="string" value="mirror" />
      <input name="filtertype" type="string" value="closest" />
    </image>
    <output name="out_base_color" type="color3" nodename="node_under_test" />
  </nodegraph>
  <standard_surface name="SR_image_addressmode_mirror" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_image_addressmode_mirror" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_image_addressmode_mirror" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_image_addressmode_mirror" />
  </surfacematerial>
</materialx>
