<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_matrix44_transformmatrix">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <add name="uv_sum" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
    </add>
    <fract name="uv_wave" type="float">
      <input name="in" type="float" nodename="uv_sum" />
    </fract>
    <combine3 name="source_vec3" type="vector3">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
      <input name="in3" type="float" nodename="uv_wave" />
    </combine3>
    <combine4 name="source_vec4" type="vector4">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
      <input name="in3" type="float" nodename="uv_wave" />
      <input name="in4" type="float" value="1.0" />
    </combine4>
    <combine4 name="matrix_row1" type="vector4">
      <input name="in1" type="float" value="1.1" />
      <input name="in2" type="float" nodename="uv_wave" />
      <input name="in3" type="float" value="0.0" />
      <input name="in4" type="float" value="0.0" />
    </combine4>
    <combine4 name="matrix_row2" type="vector4">
      <input name="in1" type="float" value="0.0" />
      <input name="in2" type="float" value="0.9" />
      <input name="in3" type="float" nodename="uv_split" output="outx" />
      <input name="in4" type="float" value="0.0" />
    </combine4>
    <combine4 name="matrix_row3" type="vector4">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" value="0.0" />
      <input name="in3" type="float" value="1.2" />
      <input name="in4" type="float" value="0.0" />
    </combine4>
    <combine4 name="matrix_row4" type="vector4">
      <input name="in1" type="float" value="0.15" />
      <input name="in2" type="float" value="0.20" />
      <input name="in3" type="float" value="0.05" />
      <input name="in4" type="float" value="1.0" />
    </combine4>
    <creatematrix name="source_matrix" type="matrix44" nodedef="ND_creatematrix_vector4_matrix44">
      <input name="in1" type="vector4" nodename="matrix_row1" />
      <input name="in2" type="vector4" nodename="matrix_row2" />
      <input name="in3" type="vector4" nodename="matrix_row3" />
      <input name="in4" type="vector4" nodename="matrix_row4" />
    </creatematrix>
    <transformmatrix name="transformed_vec3" type="vector3" nodedef="ND_transformmatrix_vector3M4">
      <input name="in" type="vector3" nodename="source_vec3" />
      <input name="mat" type="matrix44" nodename="source_matrix" />
    </transformmatrix>
    <transformmatrix name="transformed_vec4" type="vector4" nodedef="ND_transformmatrix_vector4">
      <input name="in" type="vector4" nodename="source_vec4" />
      <input name="mat" type="matrix44" nodename="source_matrix" />
    </transformmatrix>
    <separate3 name="vec3_channels" type="multioutput" nodedef="ND_separate3_vector3">
      <input name="in" type="vector3" nodename="transformed_vec3" />
    </separate3>
    <separate4 name="vec4_channels" type="multioutput" nodedef="ND_separate4_vector4">
      <input name="in" type="vector4" nodename="transformed_vec4" />
    </separate4>
    <combine3 name="final_color" type="color3">
      <input name="in1" type="float" nodename="vec3_channels" output="outx" />
      <input name="in2" type="float" nodename="vec4_channels" output="outy" />
      <input name="in3" type="float" nodename="vec4_channels" output="outz" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_matrix44_transformmatrix" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_matrix44_transformmatrix" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_matrix44_transformmatrix" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_matrix44_transformmatrix" />
  </surfacematerial>
</materialx>
