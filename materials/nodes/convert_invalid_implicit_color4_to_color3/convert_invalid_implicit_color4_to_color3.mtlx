<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_convert_invalid_implicit_color4_to_color3">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput"><input name="in" type="vector2" nodename="uv0" /></separate2>
    <add name="uv_sum" type="float"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /></add>
    <fract name="uv_mix" type="float"><input name="in" type="float" nodename="uv_sum" /></fract>
    <combine4 name="source_node" type="color4"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /><input name="in4" type="float" value="1.0" /></combine4>
    <dot name="node_under_test" type="color3">
      <input name="in" type="color3" nodename="source_node" />
    </dot>
    <output name="out_base_color" type="color3" nodename="node_under_test" />
  </nodegraph>
  <standard_surface name="SR_convert_invalid_implicit_color4_to_color3" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_convert_invalid_implicit_color4_to_color3" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_convert_invalid_implicit_color4_to_color3" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_convert_invalid_implicit_color4_to_color3" />
  </surfacematerial>
</materialx>
