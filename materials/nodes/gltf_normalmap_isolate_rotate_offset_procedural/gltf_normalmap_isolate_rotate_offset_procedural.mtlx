<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_gltf_normalmap_isolate_rotate_offset_procedural">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <add name="uv_sum" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
    </add>
    <fract name="uv_mix" type="float">
      <input name="in" type="float" nodename="uv_sum" />
    </fract>
    <multiply name="uv_rotate" type="float">
      <input name="in1" type="float" nodename="uv_mix" />
      <input name="in2" type="float" value="45.0" />
    </multiply>
    <multiply name="uv_mul" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
    </multiply>
    <combine2 name="uv_offset" type="vector2">
      <input name="in1" type="float" nodename="uv_mul" />
      <input name="in2" type="float" nodename="uv_mix" />
    </combine2>
    <gltf_normalmap name="node_under_test" type="vector3" nodedef="ND_gltf_normalmap_vector3_1_0">
      <input name="file" type="filename" value="../../showcase/standard_surface/brick_procedural/textures/brick_normal.jpg" colorspace="none" />
      <input name="default" type="vector3" value="0.5, 0.5, 1.0" />
      <input name="texcoord" type="vector2" nodename="uv0" />
      <input name="pivot" type="vector2" value="0.5, 0.5" />
      <input name="scale" type="vector2" value="1.0, 1.0" />
      <input name="rotate" type="float" nodename="uv_rotate" />
      <input name="offset" type="vector2" nodename="uv_offset" />
      <input name="uaddressmode" type="string" value="periodic" />
      <input name="vaddressmode" type="string" value="periodic" />
      <input name="filtertype" type="string" value="linear" />
    </gltf_normalmap>
    <multiply name="normal_half" type="vector3">
      <input name="in1" type="vector3" nodename="node_under_test" />
      <input name="in2" type="vector3" value="0.5, 0.5, 0.5" />
    </multiply>
    <add name="normal_01" type="vector3">
      <input name="in1" type="vector3" nodename="normal_half" />
      <input name="in2" type="vector3" value="0.5, 0.5, 0.5" />
    </add>
    <convert name="final_color" type="color3">
      <input name="in" type="vector3" nodename="normal_01" />
    </convert>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_gltf_normalmap_isolate_rotate_offset_procedural" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_gltf_normalmap_isolate_rotate_offset_procedural" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_gltf_normalmap_isolate_rotate_offset_procedural" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_gltf_normalmap_isolate_rotate_offset_procedural" />
  </surfacematerial>
</materialx>
