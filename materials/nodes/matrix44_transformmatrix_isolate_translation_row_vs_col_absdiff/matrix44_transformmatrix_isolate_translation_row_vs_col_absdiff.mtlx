<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_matrix44_transformmatrix_isolate_translation_row_vs_col_absdiff">
    <texcoord name="uv0" type="vector2" />
