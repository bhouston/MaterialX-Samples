<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <surfacematerial name="M_image_probe_identity" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_image_probe_identity" />
  </surfacematerial>
  <standard_surface name="SR_image_probe_identity" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_image_probe_identity" output="out" />
    <input name="specular_roughness" type="float" value="0.4" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <nodegraph name="NG_image_probe_identity">
    <texcoord name="uv0" type="vector2" />
    <image name="out_node" type="color3">
      <input name="file" type="filename" value="../image_format_png/textures/texture.png" colorspace="srgb_texture" />
      <input name="default" type="color3" value="1.0, 0.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="uv0" />
    </image>
    <output name="out" type="color3" nodename="out_node" />
  </nodegraph>
</materialx>
