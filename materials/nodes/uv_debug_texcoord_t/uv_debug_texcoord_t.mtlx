<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_uv_debug_texcoord_t">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <combine3 name="t_grayscale" type="color3">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
      <input name="in3" type="float" nodename="uv_split" output="outy" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="t_grayscale" />
  </nodegraph>
  <standard_surface name="SR_uv_debug_texcoord_t" type="surfaceshader">
    <input name="base_color" type="color3" value="0, 0, 0" />
    <input name="emission_color" type="color3" nodegraph="NG_uv_debug_texcoord_t" output="out_base_color" />
    <input name="emission" type="float" value="1.0" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.0" />
  </standard_surface>
  <surfacematerial name="M_uv_debug_texcoord_t" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_uv_debug_texcoord_t" />
  </surfacematerial>
</materialx>
