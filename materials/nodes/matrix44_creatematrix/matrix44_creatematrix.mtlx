<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_matrix44_creatematrix">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <add name="uv_sum" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" nodename="uv_split" output="outy" />
    </add>
    <fract name="uv_wave" type="float">
      <input name="in" type="float" nodename="uv_sum" />
    </fract>
    <combine3 name="row3_a" type="vector3">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" value="0.0" />
      <input name="in3" type="float" value="1.0" />
    </combine3>
    <creatematrix name="matrix_from_vector3" type="matrix44" nodedef="ND_creatematrix_vector3_matrix44">
      <input name="in1" type="vector3" value="1.0, 0.0, 0.0" />
      <input name="in2" type="vector3" value="0.0, 1.0, 0.0" />
      <input name="in3" type="vector3" nodename="row3_a" />
      <input name="in4" type="vector3" value="0.15, 0.10, 0.0" />
    </creatematrix>
    <combine4 name="row4_b" type="vector4">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" value="0.0" />
      <input name="in3" type="float" nodename="uv_wave" />
      <input name="in4" type="float" value="1.0" />
    </combine4>
    <creatematrix name="matrix_from_vector4" type="matrix44" nodedef="ND_creatematrix_vector4_matrix44">
      <input name="in1" type="vector4" value="1.0, 0.0, 0.0, 0.0" />
      <input name="in2" type="vector4" value="0.0, 1.0, 0.0, 0.0" />
      <input name="in3" type="vector4" value="0.0, 0.0, 1.0, 0.0" />
      <input name="in4" type="vector4" nodename="row4_b" />
    </creatematrix>
    <extract name="row_from_vector3_matrix" type="vector4" nodedef="ND_extract_matrix44">
      <input name="in" type="matrix44" nodename="matrix_from_vector3" />
      <input name="index" type="integer" value="2" />
    </extract>
    <extract name="row_from_vector4_matrix" type="vector4" nodedef="ND_extract_matrix44">
      <input name="in" type="matrix44" nodename="matrix_from_vector4" />
      <input name="index" type="integer" value="3" />
    </extract>
    <separate4 name="row3_channels" type="multioutput" nodedef="ND_separate4_vector4">
      <input name="in" type="vector4" nodename="row_from_vector3_matrix" />
    </separate4>
    <separate4 name="row4_channels" type="multioutput" nodedef="ND_separate4_vector4">
      <input name="in" type="vector4" nodename="row_from_vector4_matrix" />
    </separate4>
    <combine3 name="final_color" type="color3">
      <input name="in1" type="float" nodename="row3_channels" output="outx" />
      <input name="in2" type="float" nodename="row4_channels" output="outz" />
      <input name="in3" type="float" nodename="row4_channels" output="outw" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_matrix44_creatematrix" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_matrix44_creatematrix" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_matrix44_creatematrix" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_matrix44_creatematrix" />
  </surfacematerial>
</materialx>
