<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <texcoord name="uv0" type="vector2" />
  <separate2 name="uv_split" type="multioutput"><input name="in" type="vector2" nodename="uv0" /></separate2>
  <add name="uv_sum" type="float"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /></add>
  <fract name="uv_mix" type="float"><input name="in" type="float" nodename="uv_sum" /></fract>
  <combine4 name="source_node" type="vector4"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /><input name="in3" type="float" nodename="uv_mix" /><input name="in4" type="float" value="1.0" /></combine4>
  <convert name="node_under_test" type="surfaceshader" nodedef="ND_convert_vector4_surfaceshader">
    <input name="in" type="vector4" nodename="source_node" />
  </convert>
  <surfacematerial name="M_convert_explicit_vector4_to_surfaceshader" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="node_under_test" />
  </surfacematerial>
</materialx>
