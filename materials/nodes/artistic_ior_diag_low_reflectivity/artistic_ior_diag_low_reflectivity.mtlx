<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Diagnostic: low reflectivity -->
  <!-- Expectation: dark center, strong rim brightening in a true conductor implementation. -->
  <nodegraph name="NG_artistic_ior_diag_low_reflectivity">
    <combine3 name="reflectivity" type="color3">
      <input name="in1" type="float" value="0.05" />
      <input name="in2" type="float" value="0.05" />
      <input name="in3" type="float" value="0.05" />
    </combine3>
    <combine3 name="edge_tint" type="color3">
      <input name="in1" type="float" value="0.5" />
      <input name="in2" type="float" value="0.5" />
      <input name="in3" type="float" value="0.5" />
    </combine3>
    <artistic_ior name="artistic_ior_values" type="multioutput">
      <input name="reflectivity" type="color3" nodename="reflectivity" />
      <input name="edge_color" type="color3" nodename="edge_tint" />
    </artistic_ior>
    <range name="ior_display" type="color3">
      <input name="in" type="color3" nodename="artistic_ior_values" output="ior" />
      <input name="inlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="inhigh" type="color3" value="15.0, 15.0, 15.0" />
      <input name="outlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="outhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="gamma" type="color3" value="1.0, 1.0, 1.0" />
    </range>
    <range name="extinction_display" type="color3">
      <input name="in" type="color3" nodename="artistic_ior_values" output="extinction" />
      <input name="inlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="inhigh" type="color3" value="6.0, 6.0, 6.0" />
      <input name="outlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="outhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="gamma" type="color3" value="1.0, 1.0, 1.0" />
    </range>
    <mix name="display_color" type="color3">
      <input name="bg" type="color3" nodename="ior_display" />
      <input name="fg" type="color3" nodename="extinction_display" />
      <input name="mix" type="float" value="0.45" />
    </mix>
    <output name="out_base_color" type="color3" nodename="display_color" />
    <output name="out_emission_color" type="color3" nodename="ior_display" />
  </nodegraph>
  <standard_surface name="SR_artistic_ior_diag_low_reflectivity" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_artistic_ior_diag_low_reflectivity" output="out_base_color" />
    <input name="specular" type="float" value="0.15" />
    <input name="specular_roughness" type="float" value="0.35" />
    <input name="emission_color" type="color3" nodegraph="NG_artistic_ior_diag_low_reflectivity" output="out_emission_color" />
    <input name="emission" type="float" value="0.25" />
  </standard_surface>
  <surfacematerial name="M_artistic_ior_diag_low_reflectivity" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_artistic_ior_diag_low_reflectivity" />
  </surfacematerial>
</materialx>
