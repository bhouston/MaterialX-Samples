<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_checkerboard">
    <texcoord name="uv0" type="vector2" />
    <multiply name="checker_uv" type="vector2">
      <input name="in1" type="vector2" nodename="uv0" />
      <input name="in2" type="vector2" value="2.0, 2.0" />
    </multiply>
    <checkerboard name="node_under_test" type="color3" nodedef="ND_checkerboard_color3">
      <input name="color1" type="color3" value="0.0, 0.0, 0.0" />
      <input name="color2" type="color3" value="1.0, 1.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="checker_uv" />
    </checkerboard>
    <output name="out_base_color" type="color3" nodename="node_under_test" />
  </nodegraph>
    <standard_surface name="SR_checkerboard" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_checkerboard" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_checkerboard" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_checkerboard" />
  </surfacematerial>
</materialx>
