    <combine3 name="pos_scale" type="vector3"><input name="in1" type="float" value="6.0" /><input name="in2" type="float" value="6.0" /><input name="in3" type="float" value="6.0" /></combine3>
    <multiply name="pos_scaled" type="vector3"><input name="in1" type="vector3" nodename="pos0" /><input name="in2" type="vector3" nodename="pos_scale" /></multiply>
    <unifiednoise3d name="node_under_test" type="float" nodedef="ND_unifiednoise3d_float">
