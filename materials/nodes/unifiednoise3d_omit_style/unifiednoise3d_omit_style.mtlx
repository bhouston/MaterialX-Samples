      <input name="in2" type="float" nodename="tint_g" />
      <input name="in3" type="float" nodename="tint_b" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="base_color" />
  </nodegraph>
  <standard_surface name="SR_unifiednoise3d_omit_style" type="surfaceshader">
