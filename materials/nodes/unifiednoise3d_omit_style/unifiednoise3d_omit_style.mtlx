      <input name="outmax" type="float" value="0.9" />
      <input name="clampoutput" type="boolean" value="false" />
      <input name="octaves" type="integer" value="4" />
      <input name="lacunarity" type="float" value="2.2" />
      <input name="diminish" type="float" value="0.6" />
      <input name="type" type="integer" value="1" />
