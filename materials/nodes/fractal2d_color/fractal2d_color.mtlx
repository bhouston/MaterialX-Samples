<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_fractal2d_color">
    <texcoord name="uv0" type="vector2" />
    <multiply name="coords_under_test" type="vector2">
      <input name="in1" type="vector2" nodename="uv0" />
      <input name="in2" type="vector2" value="20.0, 17.0" />
    </multiply>
    <fractal2d name="node_under_test" type="color3" nodedef="ND_fractal2d_color3">
      <input name="amplitude" type="vector3" value="0.9, 0.75, 0.6" />
      <input name="octaves" type="integer" value="5" />
      <input name="lacunarity" type="float" value="2.25" />
      <input name="diminish" type="float" value="0.55" />
      <input name="texcoord" type="vector2" nodename="coords_under_test" />
    </fractal2d>
    <range name="color_01" type="color3">
      <input name="in" type="color3" nodename="node_under_test" />
      <input name="inlow" type="color3" value="-1.0, -1.0, -1.0" />
      <input name="inhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="outlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="outhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <output name="out_base_color" type="color3" nodename="color_01" />
  </nodegraph>
  <standard_surface name="SR_fractal2d_color" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_fractal2d_color" output="out_base_color" />
  </standard_surface>
  <surfacematerial name="M_fractal2d_color" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_fractal2d_color" />
  </surfacematerial>
</materialx>
