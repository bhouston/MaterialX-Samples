<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_convert_invalid_implicit_integer_to_float">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput"><input name="in" type="vector2" nodename="uv0" /></separate2>
    <add name="uv_sum" type="float"><input name="in1" type="float" nodename="uv_split" output="outx" /><input name="in2" type="float" nodename="uv_split" output="outy" /></add>
    <fract name="uv_mix" type="float"><input name="in" type="float" nodename="uv_sum" /></fract>
    <ifgreater name="source_node" type="integer" nodedef="ND_ifgreater_integer">
      <input name="value1" type="float" nodename="uv_mix" />
      <input name="value2" type="float" value="0.5" />
      <input name="in1" type="integer" value="2" />
      <input name="in2" type="integer" value="0" />
    </ifgreater>
    <dot name="node_under_test" type="float">
      <input name="in" type="float" nodename="source_node" />
    </dot>
    <combine3 name="display_color" type="color3"><input name="in1" type="float" nodename="node_under_test" /><input name="in2" type="float" nodename="uv_split" output="outx" /><input name="in3" type="float" value="0.2" /></combine3>
    <output name="out_base_color" type="color3" nodename="display_color" />
  </nodegraph>
  <standard_surface name="SR_convert_invalid_implicit_integer_to_float" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_convert_invalid_implicit_integer_to_float" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_convert_invalid_implicit_integer_to_float" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_convert_invalid_implicit_integer_to_float" />
  </surfacematerial>
</materialx>
