<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_cellnoise3d_large_coords">
    <position name="pos0" type="vector3" />
    <multiply name="pos_local" type="vector3">
      <input name="in1" type="vector3" nodename="pos0" />
      <input name="in2" type="vector3" value="3.0, 4.0, 5.0" />
    </multiply>
    <add name="coords_under_test" type="vector3">
      <input name="in1" type="vector3" nodename="pos_local" />
      <input name="in2" type="vector3" value="100000.125, -100000.375, 65536.625" />
    </add>
    <cellnoise3d name="node_under_test" type="float" nodedef="ND_cellnoise3d_float">
      <input name="position" type="vector3" nodename="coords_under_test" />
    </cellnoise3d>
    <range name="noise_01" type="float">
      <input name="in" type="float" nodename="node_under_test" />
      <input name="inlow" type="float" value="-1.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="1.0" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_r" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="0.59" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_g" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="0.00" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <range name="tint_b" type="float">
      <input name="in" type="float" nodename="noise_01" />
      <input name="inlow" type="float" value="0.0" />
      <input name="inhigh" type="float" value="1.0" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="1.00" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <combine3 name="base_color" type="color3">
      <input name="in1" type="float" nodename="tint_r" />
      <input name="in2" type="float" nodename="tint_g" />
      <input name="in3" type="float" nodename="tint_b" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="base_color" />
  </nodegraph>
  <standard_surface name="SR_cellnoise3d_large_coords" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_cellnoise3d_large_coords" output="out_base_color" />
  </standard_surface>
  <surfacematerial name="M_cellnoise3d_large_coords" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_cellnoise3d_large_coords" />
  </surfacematerial>
</materialx>
