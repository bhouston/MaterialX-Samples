<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="M_rotate3d_axis_x_30" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_rotate3d_axis_x_30" />
  </surfacematerial>
  <standard_surface name="SR_rotate3d_axis_x_30" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_rotate3d_axis_x_30" output="out" />
    <input name="specular_roughness" type="float" value="0.4" />
  </standard_surface>
  <nodegraph name="NG_rotate3d_axis_x_30">
    <texcoord name="uv0" type="vector2" />
    <extract name="uv0_x" type="float">
      <input name="in" type="vector2" nodename="uv0" />
      <input name="index" type="integer" value="0" />
    </extract>
    <extract name="uv0_y" type="float">
      <input name="in" type="vector2" nodename="uv0" />
      <input name="index" type="integer" value="1" />
    </extract>
    <combine3 name="uv3" type="vector3">
      <input name="in1" type="float" nodename="uv0_x" />
      <input name="in2" type="float" nodename="uv0_y" />
      <input name="in3" type="float" value="0.0" />
    </combine3>
    <rotate3d name="uv_rot" type="vector3">
      <input name="in" type="vector3" nodename="uv3" />
      <input name="amount" type="float" value="30.0" />
      <input name="axis" type="vector3" value="1.0, 0.0, 0.0" />
    </rotate3d>
    <extract name="uv_final_x" type="float">
      <input name="in" type="vector3" nodename="uv_rot" />
      <input name="index" type="integer" value="0" />
    </extract>
    <extract name="uv_final_y" type="float">
      <input name="in" type="vector3" nodename="uv_rot" />
      <input name="index" type="integer" value="1" />
    </extract>
    <combine2 name="uv_transform" type="vector2">
      <input name="in1" type="float" nodename="uv_final_x" />
      <input name="in2" type="float" nodename="uv_final_y" />
    </combine2>
    <image name="base_image" type="color3">
      <input name="file" type="filename" value="../image_format_png/textures/texture.png" colorspace="srgb_texture" />
      <input name="default" type="color3" value="1.0, 0.0, 1.0" />
      <input name="texcoord" type="vector2" nodename="uv_transform" />
    </image>
    <output name="out" type="color3" nodename="base_image" />
  </nodegraph>
</materialx>
