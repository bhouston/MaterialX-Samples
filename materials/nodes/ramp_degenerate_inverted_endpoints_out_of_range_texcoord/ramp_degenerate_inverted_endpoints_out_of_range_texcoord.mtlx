<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_ramp_degenerate_inverted_endpoints_out_of_range_texcoord">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <multiply name="u_scaled" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" value="2.0" />
    </multiply>
    <multiply name="v_scaled" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" value="2.0" />
    </multiply>
    <subtract name="u_out_of_range" type="float">
      <input name="in1" type="float" nodename="u_scaled" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <subtract name="v_out_of_range" type="float">
      <input name="in1" type="float" nodename="v_scaled" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <combine2 name="uv_out_of_range" type="vector2">
      <input name="in1" type="float" nodename="u_out_of_range" />
      <input name="in2" type="float" nodename="v_out_of_range" />
    </combine2>
    <ramplr name="ramplr_inverted" type="float" nodedef="ND_ramplr_float">
      <input name="texcoord" type="vector2" nodename="uv_out_of_range" />
      <input name="valuel" type="float" value="1.0" />
      <input name="valuer" type="float" value="0.0" />
    </ramplr>
    <ramptb name="ramptb_inverted" type="float" nodedef="ND_ramptb_float">
      <input name="texcoord" type="vector2" nodename="uv_out_of_range" />
      <input name="valueb" type="float" value="1.0" />
      <input name="valuet" type="float" value="0.0" />
    </ramptb>
    <combine3 name="debug_color" type="color3">
      <input name="in1" type="float" nodename="ramplr_inverted" />
      <input name="in2" type="float" nodename="ramptb_inverted" />
      <input name="in3" type="float" nodename="uv_split" output="outx" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="debug_color" />
  </nodegraph>
  <standard_surface name="SR_ramp_degenerate_inverted_endpoints_out_of_range_texcoord" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_ramp_degenerate_inverted_endpoints_out_of_range_texcoord" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_ramp_degenerate_inverted_endpoints_out_of_range_texcoord" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_ramp_degenerate_inverted_endpoints_out_of_range_texcoord" />
  </surfacematerial>
