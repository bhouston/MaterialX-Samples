<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_ramptb_compare_texcoord_axis">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <combine2 name="uv_swizzled" type="vector2">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" nodename="uv_split" output="outx" />
    </combine2>
    <ramptb name="ramptb_unswizzled" type="float" nodedef="ND_ramptb_float">
      <input name="texcoord" type="vector2" nodename="uv0" />
      <input name="valueb" type="float" value="0.0" />
      <input name="valuet" type="float" value="1.0" />
    </ramptb>
    <ramptb name="ramptb_swizzled" type="float" nodedef="ND_ramptb_float">
      <input name="texcoord" type="vector2" nodename="uv_swizzled" />
      <input name="valueb" type="float" value="0.0" />
      <input name="valuet" type="float" value="1.0" />
    </ramptb>
    <subtract name="swizzled_delta_raw" type="float">
      <input name="in1" type="float" nodename="ramptb_swizzled" />
      <input name="in2" type="float" nodename="uv_split" output="outx" />
    </subtract>
    <absval name="swizzled_delta" type="float">
      <input name="in" type="float" nodename="swizzled_delta_raw" />
    </absval>
    <multiply name="swizzled_delta_amplified" type="float">
      <input name="in1" type="float" nodename="swizzled_delta" />
      <input name="in2" type="float" value="8.0" />
    </multiply>
    <combine3 name="debug_color" type="color3">
      <input name="in1" type="float" nodename="ramptb_unswizzled" />
      <input name="in2" type="float" nodename="ramptb_swizzled" />
      <input name="in3" type="float" nodename="swizzled_delta_amplified" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="debug_color" />
  </nodegraph>
  <standard_surface name="SR_ramptb_compare_texcoord_axis" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_ramptb_compare_texcoord_axis" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_ramptb_compare_texcoord_axis" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_ramptb_compare_texcoord_axis" />
  </surfacematerial>
</materialx>
