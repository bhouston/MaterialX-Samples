<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_matrix44_determinant">
    <texcoord name="uv0" type="vector2" />
    <separate2 name="uv_split" type="multioutput">
      <input name="in" type="vector2" nodename="uv0" />
    </separate2>
    <multiply name="scale_x" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outx" />
      <input name="in2" type="float" value="0.2" />
    </multiply>
    <add name="diag_x" type="float">
      <input name="in1" type="float" value="0.8" />
      <input name="in2" type="float" nodename="scale_x" />
    </add>
    <multiply name="scale_y" type="float">
      <input name="in1" type="float" nodename="uv_split" output="outy" />
      <input name="in2" type="float" value="0.2" />
    </multiply>
    <add name="diag_y" type="float">
      <input name="in1" type="float" value="0.8" />
      <input name="in2" type="float" nodename="scale_y" />
    </add>
    <combine4 name="row1" type="vector4">
      <input name="in1" type="float" nodename="diag_x" />
      <input name="in2" type="float" value="0.1" />
      <input name="in3" type="float" value="0.0" />
      <input name="in4" type="float" value="0.0" />
    </combine4>
    <combine4 name="row2" type="vector4">
      <input name="in1" type="float" value="0.0" />
      <input name="in2" type="float" nodename="diag_y" />
      <input name="in3" type="float" value="0.1" />
      <input name="in4" type="float" value="0.0" />
    </combine4>
    <creatematrix name="source_matrix" type="matrix44" nodedef="ND_creatematrix_vector4_matrix44">
      <input name="in1" type="vector4" nodename="row1" />
      <input name="in2" type="vector4" nodename="row2" />
      <input name="in3" type="vector4" value="0.1, 0.0, 1.0, 0.0" />
      <input name="in4" type="vector4" value="0.0, 0.0, 0.0, 1.0" />
    </creatematrix>
    <determinant name="node_under_test" type="float" nodedef="ND_determinant_matrix44">
      <input name="in" type="matrix44" nodename="source_matrix" />
    </determinant>
    <combine3 name="final_color" type="color3">
      <input name="in1" type="float" nodename="node_under_test" />
      <input name="in2" type="float" nodename="uv_split" output="outx" />
      <input name="in3" type="float" nodename="uv_split" output="outy" />
    </combine3>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_matrix44_determinant" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_matrix44_determinant" output="out_base_color" />
    <input name="specular_roughness" type="float" value="0.45" />
    <input name="specular" type="float" value="0.5" />
  </standard_surface>
  <surfacematerial name="M_matrix44_determinant" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_matrix44_determinant" />
  </surfacematerial>
</materialx>
